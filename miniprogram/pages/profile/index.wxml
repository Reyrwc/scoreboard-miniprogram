<view class="profile-page">
  <view class="profile-card" wx:if="{{userInfo}}">
    <view class="avatar">{{userInfo.nickname ? userInfo.nickname[0] : '?'}}</view>
    <view class="profile-info">
      <view class="profile-name">{{userInfo.nickname || '未设置昵称'}}</view>
    </view>
  </view>
  <view class="profile-card" wx:else>
    <view class="avatar">?</view>
    <view class="profile-info">
      <view class="profile-name">未登录</view>
      <button class="login-btn" bindtap="onLogin">点击登录</button>
    </view>
  </view>
  <view class="quick-stats" wx:if="{{userInfo}}">
    <view class="quick-stat"><view class="quick-stat-value">{{userInfo.totalGames || 0}}</view><view class="quick-stat-label">总场次</view></view>
    <view class="quick-stat"><view class="quick-stat-value">{{userInfo.totalGames > 0 ? ((userInfo.totalWins / userInfo.totalGames * 100).toFixed(1)) : '0.0'}}%</view><view class="quick-stat-label">胜率</view></view>
    <view class="quick-stat"><view class="quick-stat-value {{(userInfo.totalWinScore - userInfo.totalLoseScore) >= 0 ? 'positive' : 'negative'}}">{{(userInfo.totalWinScore - userInfo.totalLoseScore) >= 0 ? '+' : ''}}{{(userInfo.totalWinScore - userInfo.totalLoseScore) || 0}}</view><view class="quick-stat-label">净得分</view></view>
  </view>
  <view class="menu-section">
    <view class="menu-title">我的数据</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goHistory"><text class="menu-label">历史战绩</text><text class="menu-arrow">›</text></view>
      <view class="menu-item" bindtap="goStats"><text class="menu-label">个人统计</text><text class="menu-arrow">›</text></view>
      <view class="menu-item" bindtap="goFriends"><text class="menu-label">好友排行</text><text class="menu-arrow">›</text></view>
    </view>
  </view>
  <view class="menu-section" wx:if="{{userInfo}}">
    <view class="menu-list">
      <view class="menu-item danger" bindtap="onLogout"><text class="menu-label">退出登录</text></view>
    </view>
  </view>
  <view class="version-info">记分板 v1.0.0</view>
</view>
