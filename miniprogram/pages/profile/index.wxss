.profile-page { padding-bottom: 32rpx; }
.profile-card { background: var(--color-surface); margin: 32rpx; border-radius: var(--radius-md); padding: 40rpx; display: flex; align-items: center; gap: 32rpx; }
.avatar { width: 144rpx; height: 144rpx; border-radius: var(--radius-round); background: var(--color-primary-light); color: var(--color-primary); display: flex; align-items: center; justify-content: center; font-size: 56rpx; font-weight: var(--font-weight-semibold); }
.profile-info { flex: 1; }
.profile-name { font-size: var(--font-size-xl); font-weight: var(--font-weight-bold); margin-bottom: 8rpx; }
.profile-id { font-size: var(--font-size-sm); color: var(--color-text-secondary); }
.quick-stats { display: flex; gap: 16rpx; padding: 0 32rpx; margin-bottom: 32rpx; }
.quick-stat { flex: 1; background: var(--color-surface); border-radius: var(--radius-md); padding: 24rpx 16rpx; text-align: center; }
.quick-stat-value { font-size: var(--font-size-lg); font-weight: var(--font-weight-bold); }
.quick-stat-value.positive { color: var(--color-success); }
.quick-stat-value.negative { color: var(--color-danger); }
.quick-stat-label { font-size: var(--font-size-xs); color: var(--color-text-secondary); margin-top: 8rpx; }
.menu-section { margin-bottom: 32rpx; }
.menu-title { font-size: var(--font-size-sm); font-weight: var(--font-weight-semibold); color: var(--color-text-secondary); text-transform: uppercase; letter-spacing: 1rpx; padding: 0 32rpx; margin-bottom: 16rpx; }
.menu-list { margin: 0 32rpx; background: var(--color-surface); border-radius: var(--radius-md); overflow: hidden; }
.menu-item { display: flex; align-items: center; padding: 24rpx 32rpx; border-bottom: 1rpx solid var(--color-divider); }
.menu-item:last-child { border-bottom: none; }
.menu-label { flex: 1; font-size: var(--font-size-base); }
.menu-arrow { color: var(--color-text-tertiary); font-size: var(--font-size-lg); }
.menu-item.danger .menu-label { color: var(--color-danger); }
.login-btn { background: var(--color-primary); color: #fff; border: none; border-radius: var(--radius-md); padding: 16rpx 32rpx; font-size: var(--font-size-base); margin-top: 16rpx; }
.login-btn::after { border: none; }
.version-info { text-align: center; padding: 40rpx; font-size: var(--font-size-xs); color: var(--color-text-tertiary); }
