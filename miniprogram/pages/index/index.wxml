<view class="page">
  <view class="user-section">
    <view class="avatar avatar-placeholder" wx:if="{{!isLoggedIn}}">?</view>
    <image class="avatar" wx:elif="{{userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" mode="aspectFill"/>
    <view class="avatar avatar-text" wx:else>{{userInfo.nickname[0] || '?'}}</view>

    <view class="nickname" wx:if="{{isLoggedIn}}">{{userInfo.nickname || '用户'}}</view>
    <view class="nickname" wx:else>未登录</view>

    <view class="stats-row" wx:if="{{isLoggedIn}}">
      <view class="stat-item">
        <view class="stat-value">{{userInfo.totalGames || 0}}</view>
        <view class="stat-label">总场次</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">{{userInfo.winRate}}%</view>
        <view class="stat-label">胜率</view>
      </view>
      <view class="stat-item">
        <view class="stat-value {{userInfo.netScore >= 0 ? 'positive' : 'negative'}}">
          {{userInfo.netScore >= 0 ? '+' : ''}}{{userInfo.netScore}}
        </view>
        <view class="stat-label">净得分</view>
      </view>
    </view>
  </view>

  <view class="actions">
    <button class="btn btn-primary" bindtap="onCreateRoom">
      <image class="btn-icon" src="{{icons.circlePlusWhite}}"/>
      创建房间
    </button>
    <button class="btn btn-secondary" bindtap="onScanCode">
      <image class="btn-icon" src="{{icons.qrScan}}"/>
      扫码进房
    </button>
  </view>

  <view class="active-room-card" wx:if="{{activeRoom}}" bindtap="onEnterRoom">
    <view class="active-room-info">
      <view class="active-room-name">{{activeRoom.name}}</view>
      <view class="active-room-meta">{{activeRoom.playerCount}}人 · 进行中</view>
    </view>
    <view class="active-room-arrow">></view>
  </view>
</view>
