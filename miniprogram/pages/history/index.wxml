<view class="history-page">
  <view class="date-group" wx:for="{{list}}" wx:key="_id">
    <view class="date-label">{{item.dateLabel}}</view>
    <view class="history-card" bindtap="onDetail" data-item="{{item}}">
      <view class="history-header">
        <view>
          <view class="history-title">{{item.roomName}}</view>
          <view class="history-meta">{{item.playerCount}}人 · {{item.roundCount}}局</view>
        </view>
        <view class="history-badge {{item.myScore >= 0 ? 'badge-win' : 'badge-lose'}}">
          {{item.myScore >= 0 ? '胜' : '负'}}
        </view>
      </view>
      <view class="history-players">
        <view class="player-chip" wx:for="{{item.players}}" wx:for-item="player" wx:key="openid">
          <view class="player-mini-avatar">{{player.nickname[0]}}</view>
          <view class="player-score {{player.finalScore >= 0 ? 'positive' : 'negative'}}">
            {{player.finalScore >= 0 ? '+' : ''}}{{player.finalScore}}
          </view>
        </view>
      </view>
    </view>
  </view>
  <view class="loading-tip" wx:if="{{loading}}">加载中...</view>
  <view class="empty-tip" wx:if="{{!loading && list.length === 0}}">暂无历史战绩</view>
</view>
