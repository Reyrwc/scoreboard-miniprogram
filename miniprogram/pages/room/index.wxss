.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  color: var(--color-text-secondary);
}
.nav-bar {
  background: var(--color-surface);
  padding: 24rpx 32rpx;
  text-align: center;
  border-bottom: 1rpx solid var(--color-border);
}
.nav-title { font-size: var(--font-size-md); font-weight: var(--font-weight-semibold); }
.nav-subtitle { font-size: var(--font-size-xs); color: var(--color-text-secondary); margin-top: 4rpx; }
.content { padding: 32rpx; }
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.section-label { font-size: var(--font-size-sm); font-weight: var(--font-weight-semibold); color: var(--color-text-secondary); text-transform: uppercase; letter-spacing: 1rpx; }
.round-badge { font-size: var(--font-size-xs); color: #fff; background: var(--color-primary); padding: 4rpx 16rpx; border-radius: 20rpx; }
.player-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24rpx; margin-bottom: 32rpx; }
.player-card {
  background: var(--color-surface);
  border-radius: var(--radius-md);
  padding: 24rpx;
  text-align: center;
}
.card-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-round);
  background: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: var(--font-weight-semibold);
  margin: 0 auto 12rpx;
}
.card-name { font-size: var(--font-size-sm); font-weight: var(--font-weight-medium); margin-bottom: 8rpx; }
.card-score { font-size: var(--font-size-md); font-weight: var(--font-weight-bold); font-variant-numeric: tabular-nums; }
.score-pos { color: var(--color-success); }
.score-neg { color: var(--color-danger); }
.score-zero { color: var(--color-text-secondary); }
.add-card { border: 4rpx dashed var(--color-primary); }
.add-card .card-avatar { background: var(--color-primary-light); color: var(--color-primary); }
.add-card .card-name { color: var(--color-primary); }
.record-card { background: var(--color-surface); border-radius: var(--radius-md); overflow: hidden; }
.record-item { display: flex; align-items: center; padding: 20rpx 32rpx; border-bottom: 1rpx solid var(--color-divider); }
.record-text { flex: 1; font-size: var(--font-size-base); }
.record-note { font-size: var(--font-size-sm); color: var(--color-text-secondary); margin-left: 16rpx; }
.record-score { font-size: var(--font-size-base); font-weight: var(--font-weight-semibold); color: var(--color-success); }
.empty-tip { text-align: center; padding: 40rpx; color: var(--color-text-tertiary); font-size: var(--font-size-sm); }
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--color-surface);
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
}
.btn-next {
  width: 100%;
  background: var(--color-primary);
  color: #fff;
  border: none;
  border-radius: var(--radius-md);
  padding: 28rpx;
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
}
.btn-next::after { border: none; }
