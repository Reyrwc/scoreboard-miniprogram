.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  color: var(--color-text-secondary);
}
.content { padding: 32rpx; }
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.section-label { font-size: var(--font-size-sm); font-weight: var(--font-weight-semibold); color: var(--color-text-secondary); text-transform: uppercase; letter-spacing: 1rpx; }
.round-badge { font-size: var(--font-size-xs); color: #fff; background: var(--color-primary); padding: 4rpx 16rpx; border-radius: 20rpx; }
.player-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  margin-bottom: 32rpx;
}
.player-card {
  background: transparent;
  padding: 16rpx 0;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.card-avatar-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-round);
  margin-bottom: 8rpx;
}
.card-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-round);
  background: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: var(--font-weight-semibold);
  margin-bottom: 8rpx;
}
.card-name {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  margin-bottom: 4rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.card-score { font-size: var(--font-size-md); font-weight: var(--font-weight-bold); font-variant-numeric: tabular-nums; }
.score-pos { color: var(--color-success); }
.score-neg { color: var(--color-danger); }
.score-zero { color: var(--color-text-secondary); }
.add-card .card-avatar { background: var(--color-primary-light); color: var(--color-primary); }
.add-card .card-name { color: var(--color-primary); }
.debug-card .card-avatar { background: #fff3e0; color: var(--color-warning); }
.debug-card .card-name { color: var(--color-warning); }
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--color-surface);
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
  z-index: 100;
}
.bottom-actions {
  display: flex;
  gap: 20rpx;
}
.btn-next {
  flex: 1;
  background: var(--color-primary);
  color: #fff;
  border: none;
  border-radius: var(--radius-md);
  padding: 28rpx;
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
}
.btn-next::after { border: none; }
.btn-menu {
  width: 100rpx;
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 28rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}
.btn-menu:active { background: var(--color-bg); }
.menu-dot {
  display: block;
  width: 10rpx;
  height: 10rpx;
  background: var(--color-text-secondary);
  border-radius: var(--radius-round);
}
.menu-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  justify-content: flex-end;
  align-items: flex-end;
  padding-bottom: 180rpx;
  padding-right: 32rpx;
}
.menu-popup {
  background: var(--color-surface);
  border-radius: var(--radius-md);
  box-shadow: 0 4rpx 32rpx rgba(0,0,0,0.15);
  overflow: hidden;
  min-width: 240rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 32rpx;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  border-bottom: 1rpx solid var(--color-divider);
  white-space: nowrap;
}
.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: var(--color-bg); }
.menu-item.danger { color: var(--color-danger); }
.menu-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}
.invite-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 300;
}
.invite-modal-content {
  position: relative;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 48rpx 40rpx;
  width: 80%;
  max-width: 600rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.invite-modal-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--color-text-secondary);
}
.invite-modal-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  margin-bottom: 16rpx;
}
.invite-room-name {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  margin-bottom: 32rpx;
}
.invite-qrcode {
  width: 400rpx;
  height: 400rpx;
  margin-bottom: 32rpx;
}
.invite-qrcode-loading {
  width: 400rpx;
  height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg);
  border-radius: var(--radius-md);
  margin-bottom: 32rpx;
  color: var(--color-text-secondary);
}
.invite-qrcode-fallback {
  width: 400rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--color-bg);
  border-radius: var(--radius-md);
  padding: 40rpx;
  margin-bottom: 32rpx;
}
.invite-room-id-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}
.invite-room-id {
  font-size: 48rpx;
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}
.invite-room-id-hint {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
}
.btn-share {
  width: 100%;
  background: var(--color-primary);
  color: #fff;
  border: none;
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.btn-share::after { border: none; }
.share-icon {
  width: 40rpx;
  height: 40rpx;
}
