<view class="loading" wx:if="{{isLoading}}">
  <text>加载中...</text>
</view>

<view class="room-page" wx:else>
  <view class="content">
    <view class="section-header">
      <text class="section-label">积分排名（{{room.players.length}}人）</text>
      <text class="round-badge" wx:if="{{room.currentRound > 0}}">第{{room.currentRound + 1}}局</text>
    </view>
    <view class="player-grid">
      <player-card wx:for="{{rankings}}" wx:key="openid" player="{{item}}" rank="{{index + 1}}" bind:tap="onPlayerTap" />
      <view class="player-card debug-card" wx:if="{{isActive}}" bindtap="onAddTestPlayer">
        <view class="card-avatar">+</view>
        <view class="card-name">测试</view>
      </view>
      <view class="player-card add-card" wx:if="{{isActive}}" bindtap="onShowInvite">
        <view class="card-avatar">+</view>
        <view class="card-name">邀请</view>
      </view>
    </view>

    <view class="section-header">
      <text class="section-label">记分记录</text>
    </view>
    <score-record scores="{{scores}}" currentRound="{{room.currentRound}}" />
  </view>

  <view class="bottom-bar" wx:if="{{isActive}}">
    <view class="bottom-actions">
      <button class="btn-next" bindtap="onNextRound">下一局</button>
      <view class="btn-menu" bindtap="onToggleMenu">
        <view class="menu-dot"></view>
        <view class="menu-dot"></view>
        <view class="menu-dot"></view>
      </view>
    </view>
  </view>

  <view class="menu-mask" wx:if="{{showMenu}}" bindtap="onCloseMenu">
    <view class="menu-popup" catchtap="onMenuTap">
      <view class="menu-item" catchtap="onShowInvite">
        <image class="menu-icon" src="{{icons.people}}"/>
        <text>邀请好友</text>
      </view>
      <view class="menu-item" catchtap="onMenuLeave">
        <image class="menu-icon" src="{{icons.logout}}"/>
        <text>退出房间</text>
      </view>
      <view class="menu-item danger" wx:if="{{isOwner}}" catchtap="onMenuDissolve">
        <image class="menu-icon" src="{{icons.logout}}"/>
        <text>解散房间</text>
      </view>
    </view>
  </view>

  <view class="invite-modal" wx:if="{{showInviteModal}}" bindtap="onCloseInviteModal">
    <view class="invite-modal-content" catchtap="onModalContentTap">
      <view class="invite-modal-close" bindtap="onCloseInviteModal">×</view>
      <view class="invite-modal-title">邀请好友加入</view>
      <view class="invite-room-name">{{room.name}}</view>
      <view class="invite-qrcode-wrap">
        <image class="invite-qrcode" wx:if="{{qrcodeUrl}}" src="{{qrcodeUrl}}" mode="aspectFit"/>
        <view class="invite-qrcode-loading" wx:elif="{{qrError}}">
          <view class="qr-error-box">
            <text class="qr-error-text">二维码加载失败：{{qrError}}</text>
            <view class="qr-retry-btn" catchtap="onRetryQRCode">重新加载</view>
          </view>
        </view>
        <view class="invite-qrcode-loading" wx:else>
          <text>加载中...</text>
        </view>
      </view>
      <button class="btn-share" open-type="share">
        <image class="share-icon" src="{{icons.shareWhite}}"/>
        转发给好友
      </button>
    </view>
  </view>

  <score-modal visible="{{showScoreModal}}" targetPlayer="{{targetPlayer}}" bind:close="onScoreClose" bind:confirm="onScoreConfirm" />

  <view class="nickname-modal" wx:if="{{showNicknameEdit}}" bindtap="onNicknameModalOverlay">
    <view class="nickname-modal-content" catchtap="onNicknameModalContent">
      <view class="nickname-modal-title">修改昵称</view>
      <input class="nickname-modal-input" type="nickname" value="{{editNickname}}" bindinput="onNicknameInput" placeholder="请输入昵称" maxlength="10"/>
      <view class="nickname-modal-actions">
        <view class="nickname-modal-btn cancel" bindtap="onCloseNicknameEdit">取消</view>
        <view class="nickname-modal-btn confirm" bindtap="onSaveNickname">保存</view>
      </view>
    </view>
  </view>
</view>
