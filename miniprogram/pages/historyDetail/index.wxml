<view wx:if="{{history}}" class="detail-page">
  <view class="room-info">
    <view class="room-name">{{history.roomName}}</view>
    <view class="room-date">{{history.dateLabel}} · {{history.timeRange}} · {{history.playerCount}}人 · {{history.roundCount}}局</view>
  </view>

  <view class="stats-row">
    <view class="stat-card">
      <view class="stat-value">{{history.roundCount}}</view>
      <view class="stat-label">总轮次</view>
    </view>
    <view class="stat-card">
      <view class="stat-value">{{history.playerCount}}</view>
      <view class="stat-label">玩家数</view>
    </view>
    <view class="stat-card">
      <view class="stat-value">{{history.totalScores}}</view>
      <view class="stat-label">总记分</view>
    </view>
  </view>

  <view class="section-header">
    <text class="section-title">最终排名</text>
  </view>
  <view class="rank-list">
    <view class="rank-item" wx:for="{{history.players}}" wx:key="openid">
      <view class="rank-position {{index < 3 ? 'top-' + (index + 1) : ''}}">{{item.rank}}</view>
      <image class="rank-avatar-img" wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill"/>
      <view class="rank-avatar" wx:else>{{item.nickname ? item.nickname[0] : '?'}}</view>
      <view class="rank-info">
        <view class="rank-name">{{item.nickname}}</view>
      </view>
      <view class="rank-score {{item.finalScore >= 0 ? 'positive' : 'negative'}}">
        {{item.finalScore >= 0 ? '+' : ''}}{{item.finalScore}}
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <button class="btn-share" open-type="share">
      <image class="btn-share-icon" src="{{icons.share}}"/>
      分享战绩
    </button>
  </view>
</view>
<view class="loading" wx:else>加载中...</view>
