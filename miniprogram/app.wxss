/**app.wxss**/

/* ===== Design Tokens (iOS-style) ===== */
page {
  /* Colors */
  --color-primary: #007AFF;
  --color-primary-light: #5AC8FA;
  --color-success: #34C759;
  --color-danger: #FF3B30;
  --color-warning: #FF9500;
  --color-info: #5856D6;

  --color-bg: #F2F2F7;
  --color-surface: #FFFFFF;
  --color-surface-secondary: #F9F9F9;
  --color-border: #E5E5EA;
  --color-divider: #C6C6C8;

  --color-text-primary: #1C1C1E;
  --color-text-secondary: #8E8E93;
  --color-text-tertiary: #C7C7CC;
  --color-text-inverse: #FFFFFF;

  /* Typography */
  --font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
  --font-size-xs: 20rpx;
  --font-size-sm: 24rpx;
  --font-size-base: 28rpx;
  --font-size-md: 32rpx;
  --font-size-lg: 36rpx;
  --font-size-xl: 40rpx;
  --font-size-xxl: 48rpx;

  --font-weight-regular: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;

  --line-height-tight: 1.2;
  --line-height-normal: 1.5;
  --line-height-relaxed: 1.8;

  /* Spacing */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-base: 32rpx;
  --spacing-lg: 48rpx;
  --spacing-xl: 64rpx;

  /* Border Radius */
  --radius-sm: 8rpx;
  --radius-base: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-round: 50%;

  /* Shadows (iOS-style) */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow-base: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  --shadow-md: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  --shadow-lg: 0 16rpx 48rpx rgba(0, 0, 0, 0.16);

  /* Transitions */
  --transition-fast: 0.15s ease;
  --transition-base: 0.25s ease;
  --transition-slow: 0.4s ease;

  background: var(--color-bg);
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  font-family: var(--font-family);
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  line-height: var(--line-height-normal);
}

/* ===== Utility Classes ===== */

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  padding: var(--spacing-base);
  width: 100%;
}

.card {
  background: var(--color-surface);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-base);
  padding: var(--spacing-base);
  margin-bottom: var(--spacing-md);
  width: 100%;
  box-sizing: border-box;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 var(--spacing-lg);
  border-radius: var(--radius-base);
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-medium);
  line-height: 88rpx;
  text-align: center;
  transition: opacity var(--transition-fast);
  border: none;
  outline: none;
  box-sizing: border-box;
}

.btn::after {
  border: none;
}

.btn:active {
  opacity: 0.7;
}

.btn-primary {
  background: var(--color-primary);
  color: var(--color-text-inverse);
}

.btn-secondary {
  background: var(--color-surface);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

.text-success {
  color: var(--color-success);
}

.text-danger {
  color: var(--color-danger);
}

.text-secondary {
  color: var(--color-text-secondary);
}

button {
  background: initial;
  padding: 0;
  margin: 0;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}
