<view class="record-card" wx:if="{{scores.length > 0}}">
  <view wx:for="{{groups}}" wx:key="roundLabel" wx:for-item="group">
    <view class="round-header" wx:if="{{group.roundLabel}}">{{group.roundLabel}}</view>
    <view class="record-item" wx:for="{{group.items}}" wx:key="_id" wx:for-item="rec">
      <image class="record-avatar-img" wx:if="{{rec.fromAvatarUrl}}" src="{{rec.fromAvatarUrl}}" mode="aspectFill"/>
      <view class="record-avatar" wx:else>{{rec.fromNickname ? rec.fromNickname[0] : '?'}}</view>
      <view class="record-body">
        <view class="record-text">
          <text>{{rec.fromNickname}} → {{rec.toNickname}}</text>
          <text class="record-note" wx:if="{{rec.note}}">（{{rec.note}}）</text>
        </view>
      </view>
      <view class="record-meta">
        <view class="record-score">+{{rec.amount}}</view>
        <view class="record-time">{{rec._time}}</view>
      </view>
    </view>
  </view>
</view>
<view class="empty-tip" wx:else>暂无记分记录</view>
