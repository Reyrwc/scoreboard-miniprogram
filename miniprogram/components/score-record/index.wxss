.record-card {
  background: var(--color-surface);
  border-radius: var(--radius-md);
  overflow: hidden;
}
.round-header {
  padding: 16rpx 32rpx;
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-secondary);
  background: var(--color-background);
  border-bottom: 1rpx solid var(--color-divider);
}
.record-item {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--color-divider);
}
.record-item:last-child {
  border-bottom: none;
}
.record-player {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}
.record-avatar-img {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.record-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.record-name {
  font-size: var(--font-size-base);
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.record-arrow {
  margin: 0 12rpx;
  color: var(--color-text-tertiary);
  font-size: var(--font-size-base);
  flex-shrink: 0;
}
.record-note {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-left: 8rpx;
}
.record-meta {
  margin-left: auto;
  text-align: right;
  padding-left: 16rpx;
}
.record-score {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  color: var(--color-success);
}
.record-time {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}
.empty-tip {
  text-align: center;
  padding: 40rpx;
  color: var(--color-text-tertiary);
  font-size: var(--font-size-sm);
}
