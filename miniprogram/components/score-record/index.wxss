.record-card {
  background: var(--color-surface);
  border-radius: var(--radius-md);
  overflow: hidden;
}
.record-item {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--color-divider);
}
.record-item:last-child {
  border-bottom: none;
}
.record-text {
  flex: 1;
  font-size: var(--font-size-base);
}
.record-avatar-img {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.record-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.record-note {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-left: 16rpx;
}
.record-meta {
  text-align: right;
}
.record-score {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  color: var(--color-success);
}
.empty-tip {
  text-align: center;
  padding: 40rpx;
  color: var(--color-text-tertiary);
  font-size: var(--font-size-sm);
}
