.dice-overlay {
  display: none;
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
  align-items: center;
  padding-bottom: 30vh;
  justify-content: center;
}
.dice-overlay.active { display: flex; }

.dice-sheet {
  position: relative;
  background: var(--color-surface);
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  width: 80%;
  max-width: 600rpx;
}

.dice-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--color-text-secondary);
}

.dice-title {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  text-align: center;
  margin-bottom: 32rpx;
}

/* 数量选择 */
.dice-count-row {
  display: flex;
  gap: 16rpx;
  justify-content: center;
  margin-bottom: 32rpx;
}
.dice-count-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--color-bg);
  color: var(--color-text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
}
.dice-count-btn.active {
  background: var(--color-primary);
  color: #fff;
}

/* 骰子结果区域 */
.dice-result-area {
  display: flex;
  gap: 16rpx;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 32rpx;
  min-height: 120rpx;
}

/* 单个骰子 */
.die {
  width: 100rpx;
  height: 100rpx;
}
.die.rolling {
  animation: shake 0.1s ease-in-out infinite alternate;
}
@keyframes shake {
  0% { transform: rotate(-15deg) scale(1.05); }
  100% { transform: rotate(15deg) scale(1.05); }
}

.die-face {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #f8f8f8, #e8e8e8);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.1);
  display: grid;
  padding: 16rpx;
  box-sizing: border-box;
}
.dot {
  width: 16rpx;
  height: 16rpx;
  background: var(--color-text-primary);
  border-radius: 50%;
}

/* 骰子点数布局 */
.die-1 { grid-template: 1fr / 1fr; place-items: center; }
.die-2 { grid-template: 1fr 1fr / 1fr; }
.die-2 .dot:nth-child(1) { justify-self: end; align-self: start; }
.die-2 .dot:nth-child(2) { justify-self: start; align-self: end; }
.die-3 { grid-template: 1fr 1fr 1fr / 1fr; }
.die-3 .dot:nth-child(1) { justify-self: end; align-self: start; }
.die-3 .dot:nth-child(2) { justify-self: center; align-self: center; }
.die-3 .dot:nth-child(3) { justify-self: start; align-self: end; }
.die-4 { grid-template: 1fr 1fr / 1fr 1fr; place-items: center; }
.die-5 { grid-template: 1fr 1fr 1fr / 1fr 1fr 1fr; }
.die-5 .dot:nth-child(1) { grid-area: 1/1; justify-self: center; align-self: center; }
.die-5 .dot:nth-child(2) { grid-area: 1/3; justify-self: center; align-self: center; }
.die-5 .dot:nth-child(3) { grid-area: 2/2; justify-self: center; align-self: center; }
.die-5 .dot:nth-child(4) { grid-area: 3/1; justify-self: center; align-self: center; }
.die-5 .dot:nth-child(5) { grid-area: 3/3; justify-self: center; align-self: center; }
.die-6 { grid-template: 1fr 1fr 1fr / 1fr 1fr; place-items: center; }

/* 投掷按钮 */
.dice-roll-btn {
  width: 100%;
  background: var(--color-primary);
  color: #fff;
  border: none;
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
}
.dice-roll-btn::after { border: none; }
.dice-roll-btn[disabled] { opacity: 0.6; }
