<view class="dice-overlay {{visible ? 'active' : ''}}" bindtap="onClose">
  <view class="dice-sheet" catchtap>
    <view class="dice-close" bindtap="onClose">×</view>
    <view class="dice-title">摇骰子</view>

    <!-- 数量选择 -->
    <view class="dice-count-row">
      <view
        class="dice-count-btn {{diceCount === item ? 'active' : ''}}"
        wx:for="{{[1,2,3,4,5]}}"
        wx:key="*this"
        bindtap="onSelectCount"
        data-count="{{item}}"
      >{{item}}</view>
    </view>

    <!-- 3D 骰子结果展示 -->
    <view class="dice-result-area">
      <view class="die-3d-wrap" wx:for="{{diceResults}}" wx:key="index">
        <view class="dice-scene">
          <view class="dice-cube {{noTransition ? 'no-transition' : ''}}" style="transform: {{diceTransforms[index] || 'rotateX(0deg) rotateY(0deg)'}}">
            <!-- 面1: front -->
            <view class="cube-face cube-front die-1">
              <view class="dot"></view>
            </view>
            <!-- 面2: right -->
            <view class="cube-face cube-right die-2">
              <view class="dot"></view>
              <view class="dot"></view>
            </view>
            <!-- 面3: top -->
            <view class="cube-face cube-top die-3">
              <view class="dot"></view>
              <view class="dot"></view>
              <view class="dot"></view>
            </view>
            <!-- 面4: bottom -->
            <view class="cube-face cube-bottom die-4">
              <view class="dot"></view>
              <view class="dot"></view>
              <view class="dot"></view>
              <view class="dot"></view>
            </view>
            <!-- 面5: left -->
            <view class="cube-face cube-left die-5">
              <view class="dot"></view>
              <view class="dot"></view>
              <view class="dot"></view>
              <view class="dot"></view>
              <view class="dot"></view>
            </view>
            <!-- 面6: back -->
            <view class="cube-face cube-back die-6">
              <view class="dot"></view>
              <view class="dot"></view>
              <view class="dot"></view>
              <view class="dot"></view>
              <view class="dot"></view>
              <view class="dot"></view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 投掷按钮 -->
    <button class="dice-roll-btn" bindtap="onRoll" disabled="{{rolling}}">投掷</button>
  </view>
</view>
