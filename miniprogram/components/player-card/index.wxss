.player-card {
  background: transparent;
  padding: 16rpx 0;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.card-avatar-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-round);
  margin-bottom: 8rpx;
}
.card-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-round);
  background: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: var(--font-weight-semibold);
  margin-bottom: 8rpx;
}
.card-name {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  margin-bottom: 4rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.card-score {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-bold);
  font-variant-numeric: tabular-nums;
}
.score-pos { color: var(--color-success); }
.score-neg { color: var(--color-danger); }
.score-zero { color: var(--color-text-secondary); }
