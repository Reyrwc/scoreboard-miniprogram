.player-card {
  background: var(--color-surface);
  border-radius: var(--radius-md);
  padding: 24rpx;
  text-align: center;
}
.card-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-round);
  background: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: var(--font-weight-semibold);
  margin: 0 auto 12rpx;
}
.card-name { font-size: var(--font-size-sm); font-weight: var(--font-weight-medium); margin-bottom: 8rpx; }
.card-score { font-size: var(--font-size-md); font-weight: var(--font-weight-bold); font-variant-numeric: tabular-nums; }
.score-pos { color: var(--color-success); }
.score-neg { color: var(--color-danger); }
.score-zero { color: var(--color-text-secondary); }
