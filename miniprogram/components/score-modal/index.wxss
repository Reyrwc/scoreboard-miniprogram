.modal-overlay {
  display: none;
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
  align-items: flex-end;
  justify-content: center;
}
.modal-overlay.active { display: flex; }
.modal-sheet {
  background: var(--color-surface);
  border-radius: 24rpx 24rpx 0 0;
  padding: 48rpx 32rpx;
  width: 100%;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}
.modal-title { font-size: var(--font-size-md); font-weight: var(--font-weight-semibold); }
.modal-close { font-size: var(--font-size-md); color: var(--color-primary); }
.input-row { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.score-input {
  flex: 1;
  background: var(--color-bg);
  border: none;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  text-align: center;
}
.quick-btns { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; margin-bottom: 32rpx; }
.quick-btn {
  background: var(--color-bg);
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  text-align: center;
}
.note-input {
  background: var(--color-bg);
  border: none;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: var(--font-size-base);
  margin-bottom: 32rpx;
}
.btn-submit {
  width: 100%;
  background: var(--color-primary);
  color: var(--color-surface);
  border: none;
  border-radius: var(--radius-md);
  padding: 28rpx;
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
}
.btn-submit::after { border: none; }
