.modal-overlay {
  display: none;
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
  align-items: center;
  padding-bottom: 20vh;
  justify-content: center;
}
.modal-overlay.active { display: flex; }
.modal-sheet {
  position: relative;
  background: var(--color-surface);
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  width: 80%;
  max-width: 600rpx;
}
.modal-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--color-text-secondary);
}
.modal-title {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  text-align: center;
  margin-bottom: 40rpx;
}
.input-row { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.score-input {
  flex: 1;
  background: var(--color-bg);
  border: none;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  text-align: center;
}
.btn-submit {
  width: 100%;
  background: var(--color-primary);
  color: var(--color-surface);
  border: none;
  border-radius: var(--radius-md);
  padding: 28rpx;
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
}
.btn-submit::after { border: none; }
